# WiFiSense Ultra — safe starter configuration
WIFISENSE_WEB_PORT=5000
WIFISENSE_TCP_PORT=8089
WIFISENSE_SAMPLE_RATE=20
WIFISENSE_SUBCARRIERS=64
WIFISENSE_CALIBRATION_FRAMES=150
WIFISENSE_MOTION_Z_THRESH=2.5

# Room dimensions used by the dashboard and position bounds
WIFISENSE_ROOM_WIDTH_M=10
WIFISENSE_ROOM_DEPTH_M=5
WIFISENSE_ROOM_HEIGHT_M=3

# Fall detector: sudden standardized spike -> settling -> stillness
WIFISENSE_FALL_AMP_SPIKE_Z=6.0
WIFISENSE_FALL_SPIKE_RATIO=2.0
WIFISENSE_FALL_SPIKE_VELOCITY_Z=2.5
WIFISENSE_FALL_POST_SPIKE_MOTION_GRACE_SEC=0.6
WIFISENSE_FALL_STILLNESS_Z=1.6
WIFISENSE_FALL_STILLNESS_VELOCITY_Z=1.5
WIFISENSE_FALL_MAX_ACTIVE_SUBCARRIERS=10
WIFISENSE_FALL_STILLNESS_SEC=3.0
WIFISENSE_FALL_CONFIRM_WINDOW_SEC=8.0
WIFISENSE_FALL_COOLDOWN_SEC=10.0

# Optional: protect mutating API calls with Bearer auth
# WIFISENSE_API_TOKEN=change-me

# Optional: require NODE|id|token authentication on TCP 8089
# WIFISENSE_INGEST_TOKEN=change-this-node-secret

# Optional Home Assistant / MQTT
WIFISENSE_MQTT_ENABLED=0
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=wifisense
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_ROOM=living_room
# MQTT_USERNAME=
# MQTT_PASSWORD=
